# ==========================================================
# 1. GOOGLE GEMINI LLM API KEY (100% FREE TIER)
# Where to get it free: https://aistudio.google.com/app/apikey
# ==========================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================================
# 2. GROQ CLOUD LLM API KEY (100% FREE TIER BACKUP)
# Where to get it free: https://console.groq.com/keys
# ==========================================================
GROQ_API_KEY=your_groq_api_key_here

# ==========================================================
# 3. SUPABASE (100% FREE TIER - Google Auth + Database)
# Where to get it free: https://supabase.com/dashboard
# ==========================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
