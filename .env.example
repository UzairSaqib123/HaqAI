# ==========================================================
# 1. GOOGLE GEMINI LLM API KEY (100% FREE TIER)
# Where to get it free: https://aistudio.google.com/app/apikey
# Sign in with Google -> Click "Create API Key" -> Copy & Paste below
# ==========================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================================
# 2. GROQ CLOUD LLM API KEY (100% FREE TIER - Ultra-Fast Llama 3.3 70B Backup)
# Where to get it free: https://console.groq.com/keys
# Sign in with Google/GitHub -> Click "Create API Key" -> Copy & Paste below
# ==========================================================
GROQ_API_KEY=

# ==========================================================
# 3. OPENROUTER API KEY (100% FREE TIER - Free Open Models Backup)
# Where to get it free: https://openrouter.ai/settings/keys
# Sign in -> Click "Create Key" -> Copy & Paste below
# ==========================================================
OPENROUTER_API_KEY=

# ==========================================================
# 4. SUPABASE (100% FREE TIER - Google Auth + Database for Profiles & Cases)
# Where to get it free: https://supabase.com/dashboard
# Create New Project -> Go to Project Settings -> API -> Copy Project URL & anon public key
# ==========================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==========================================================
# 5. META WHATSAPP CLOUD API (100% FREE TIER - 1,000 Free Conversations/mo)
# Where to get it free: https://developers.facebook.com/apps
# Create Business App -> Add WhatsApp Product -> API Setup -> Copy Token & Phone Number ID
# ==========================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
WHATSAPP_VERIFY_TOKEN=haqai_whatsapp_verify_2026
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Public URL of your website
NEXT_PUBLIC_APP_URL=http://localhost:3000
